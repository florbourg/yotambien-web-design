                            {
                              "type": "text",
                              "id": "Q3U2A",
                              "name": "Con el tiempo fuimos creando un método e",
                              "context": "p",
                              "fill": "#262627",
                              "textGrowth": "fixed-width-height",
                              "width": "fill_container",
                              "height": 121.59,
                              "content": "Con el tiempo fuimos creando un método educativo propio que nos permite enseñar técnicas fotográficas y audiovisuales muy complejas, de una forma lúdica capaz de respetar el ritmo de aprendizaje de cada participante.",
