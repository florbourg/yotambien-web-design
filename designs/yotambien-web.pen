                                    },
                                    {
                                      "type": "frame",
                                      "id": "MAL95",
                                      "name": "div",
                                      "context": "div",
                                      "clip": true,
                                      "height": 638.11,
                                      "fill": "#262627",
                                      "cornerRadius": 40,
                                      "layout": "vertical",
                                      "padding": 32,
                                      "children": [
                                        {
                                          "id": "IpvO9",
                                          "type": "ref",
                                          "ref": "D2hKl",
                                          "name": "TestimonialCard / Adrián Barreto",
                                          "width": 1246,
                                          "descendants": {
                                            "qO1aj": {
                                              "content": "\"Coherencia e Inclusión definen a Yo También!\"",
                                              "fontSize": 24
                                            },
                                            "o85zBx": {
                                              "content": "Coherencia e Inclusión definen a Yo También! y me identifican porque cuando era gerente de Sustentabilidad en GIRE, contrataba sus servicios para eventos corporativos, pero luego en el plano individual la elegí para que me hicieran la producción de mi book personal y profesional. Sentí seguir colaborando y siendo parte de esta organización de impacto social, para apoyar su propósito. Agradezco tener a Melina en mi círculo cercano y valoro mucho el trabajo de cada persona que hacen Yo También!",
                                              "fontSize": 16
                                            },
                                            "MNiYM": {
                                              "content": "Adrián Barreto",
                                              "fontSize": 16
                                            },
                                            "eNp0F": {
                                              "content": "Comunicador Social, Master Coach, Consultor. Coordinador de Alianzas y Comunidades en SILVERTECH y DIAGONAL",
                                              "fontSize": 12.8,
                                              "fontStyle": "italic"
                                            },
                                            "pEkZG": {
                                              "width": 561,
                                              "height": 404,
