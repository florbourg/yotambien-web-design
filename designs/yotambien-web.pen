                                          "name": "TestimonialCard / Jesica Lores",
                                          "width": 1246,
                                          "descendants": {
                                            "bX74J": {
                                              "width": 150,
                                              "height": 34,
                                              "fill": {
                                                "type": "image",
                                                "enabled": true,
                                                "url": "yotambien-web-assets/a95c922a400909ce.png",
                                                "mode": "contain"
                                              }
                                            },
                                            "qO1aj": {
                                              "content": "\"Realmente destaco el profesionalismo\"",
                                              "fontSize": 24
                                            },
                                            "o85zBx": {
                                              "content": "Hemos contratado el servicio de fotografía para distintos eventos de la Compañía como los encuentros con Grupos de Interés y fiesta de fin de año con colaboradores. Realmente destaco el profesionalismo y la calidad del trabajo como así también la posibilidad de poder interactuar con personas con discapacidad. Realmente para nosotros contar con un proveedor como Yo También! nos potencia, nos permite vivir la sustentabilidad y promover una cadena de valor inclusiva.",
                                              "fontSize": 16
                                            },
                                            "MNiYM": {
                                              "content": "Jesica Lores",
                                              "fontSize": 16
                                            },
                                            "eNp0F": {
                                              "content": "Supervisora de Sustentabilidad y Comunicaciones Corporativas de PRUDENTIAL",
                                              "fontSize": 12.8,
