                                      "children": [
                                        {
                                          "id": "Yfl4z",
                                          "type": "ref",
                                          "ref": "D2hKl",
                                          "name": "TestimonialCard / Pablo Fiuza",
                                          "width": 1246,
                                          "descendants": {
                                            "bX74J": {
                                              "width": 190,
                                              "height": 40,
                                              "fill": {
                                                "type": "image",
                                                "enabled": true,
                                                "url": "yotambien-web-assets/419cb910d221d310.png",
                                                "mode": "contain"
                                              }
                                            },
                                            "qO1aj": {
                                              "content": "\"El compromiso profesional con el que lo hacen, es destacable\"",
                                              "fontSize": 24
                                            },
                                            "o85zBx": {
                                              "content": "Elegimos contratar a Yo También! para el casting y la producción de las fotos de nuestra App “Emocionalmente”. La calidad de su trabajo, y el compromiso profesional con el que lo hacen, es destacable. Como líder de una empresa de tecnología considero que iniciativas como la productora de Yo También! aportan mucho valor a la inclusión digital, que afortunadamente es parte de nuestro presente.",
                                              "fontSize": 16
                                            },
                                            "MNiYM": {
                                              "content": "Pablo Fiuza",
                                              "fontSize": 16
                                            },
                                            "eNp0F": {
                                              "content": "CEO Qservices, Presidente de la Cámara Argentina de la Industria del Software. Presidente Fundación TINC",
                                              "fontSize": 12.8,
