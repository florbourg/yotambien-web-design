                  "children": [
                    {
                      "type": "text",
                      "id": "owxu0",
                      "name": "Creemos que la inclusión de las personas",
                      "context": "p",
                      "fill": "#ffffff",
                      "textGrowth": "fixed-width-height",
                      "width": 960,
                      "height": 134.41,
                      "content": "Creemos que la inclusión de las personas con discapacidad implica, entre otras cosas, ofrecer espacios de formación de calidad innovadores y acordes a las actividades del mundo de hoy, para que adquieran herramientas que les permitan expresarse y trabajar en las áreas de comunicación de empresas y/o medios de comunicación.",
                      "lineHeight": 1.5,
                      "fontFamily": "Montserrat",
                      "fontSize": 22.4,
                      "fontWeight": "normal"
                    }
                  ]
