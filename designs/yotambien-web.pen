                          "height": 135.99,
                          "layout": "vertical",
                          "children": [
                            {
                              "type": "text",
                              "id": "J4RQCk",
                              "name": "Ofrecemos una formación de calidad busca",
                              "context": "p",
                              "fill": "#262627",
                              "textGrowth": "fixed-width-height",
                              "width": "fill_container",
                              "height": 121.59,
                              "content": "Ofrecemos una formación de calidad buscando que las personas con discapacidad, además de aprender, accedan trabajos acordes a sus capacidades adquiridas, como así también puedan compartir sus producciones dentro del ámbito cultural.",
                              "lineHeight": 1.54,
                              "fontFamily": "Montserrat",
                              "fontSize": 19.68,
                              "fontWeight": "normal"
                            }
                          ]
                        }
                      ]
                    }
                  ]
